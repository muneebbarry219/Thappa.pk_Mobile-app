EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Google Sign-In (optional). OAuth 2.0 Client ID (type: Web), same value as
# the backend's GOOGLE_CLIENT_ID. Needs a custom dev client / standalone
# build to complete the redirect — the button falls back to an explainer
# alert in Expo Go or until this is set.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Phone Auth (optional). From your Firebase project's Web app config
# (Project settings -> General -> Your apps). Until all four are set, phone
# sign-in uses the console-logged dev OTP instead of real SMS.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
